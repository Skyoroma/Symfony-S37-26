{% extends 'base.html.twig' %}

{% block title %}Hello ProductController!{% endblock %}

{% block stylesheets %}
{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; background: #f5f5f5f3; }
    .example-wrapper code { background: #f5f5f5f3; padding: 2px 6px; }
    .product {
        margin-bottom: 20px;
        padding: 15px;
        border: 1px solid #ccc;
        border-radius: 30px;
    }
</style>


<div class="example-wrapper">
    <h1>Hello {{ controller_name }}! ✅</h1>

    <a href="{{ path('app_products_add')}}">
        Ajouter un produit
    </a>

    {% for product in products %}
        <div class="product">
            <h2>{{ product.name }}</h2>
            <ul>
                <li>Description : {{ product.description }}</li>
                <li>Prix : {{ product.price }} €</li>
                <li>Quantité : {{ product.quantity }}</li>
            </ul>

            <form method="post"
                action="{{ path('app_products_delete', {id: product.id}) }}"
                onsubmit="return confirm('Voulez-vous vraiment supprimer ce produit ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                <button type="submit">Supprimer</button>
            </form>
        </div>
    {% endfor %}
</div>

{% endblock %}